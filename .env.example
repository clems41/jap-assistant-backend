# Copy this file to .env for local development
# NEVER commit .env files with real secrets

# Django
SECRET_KEY=django-insecure-change-me-for-production
DJANGO_SETTINGS_MODULE=config.settings.local

# Database (overridden by docker-compose.yml for Docker usage)
DATABASE_URL=postgresql://jap:jap@localhost:5432/jap_local

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# --- Production only (config.settings.prod) ---
# ALLOWED_HOSTS=yourdomain.com
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=user@example.com
# EMAIL_HOST_PASSWORD=your-smtp-password
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# SENTRY_DSN=https://...@sentry.io/...
